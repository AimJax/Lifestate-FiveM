@@ -0,0 +1,30 @@
+import React from 'react';
+import { Box } from '@mui/material';
+
+// LS One shared app header: red micro-bar + bold title. Used by built-in
+// system apps so they read as one OS family. Presentation only.
+export const LsOneHeader: React.FC<{ title: string }> = ({ title }) => {
+  return (
+    <Box sx={{ padding: '14px 20px 4px' }}>
+      <Box
+        sx={{
+          width: '28px',
+          height: '3px',
+          borderRadius: '2px',
+          backgroundColor: '#D71920',
+          marginBottom: '8px',
+        }}
+      />
+      <Box
+        sx={{
+          color: '#FFFFFF',
+          fontSize: '20px',
+          fontWeight: 800,
+          letterSpacing: '0.5px',
+        }}
+      >
+        {title}
+      </Box>
+    </Box>
+  );
+};
