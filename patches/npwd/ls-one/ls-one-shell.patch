 import { useApps } from '@os/apps/hooks/useApps';
 import { useExternalApps } from '@common/hooks/useExternalApps';
+import { IApp } from '@os/apps/config/apps';
+
+// LS One dock: exactly these core apps live in the hotbar, in this order.
+// Everything else (including dynamic external apps) stays in the grid.
+const DOCK_APP_IDS = ['DIALER', 'MESSAGES', 'CONTACTS', 'CAMERA'];
+
+const DockApp: React.FC<{ app: IApp }> = ({ app }) => (
+  <Link
+    to={app.path}
+    style={{ textDecoration: 'none', display: 'flex' }}
+    key={app.id}
+  >
+    <AppIcon {...app} dense />
+  </Link>
+);
 
 export const HomeApp: React.FC = () => {
   const { apps } = useApps();
   const externalApps = useExternalApps();
+  const allApps = [...(apps || []), ...(externalApps || [])];
+  const dockApps = DOCK_APP_IDS.map((id) => allApps.find((app) => app && app.id === id)).filter(
+    (app): app is IApp => !!app && !app.isDisabled,
+  );
+  const dockIds = new Set(dockApps.map((app) => app.id));
+  const gridApps = allApps.filter((app) => app && !dockIds.has(app.id));
+
   return (
     <AppWrapper>
