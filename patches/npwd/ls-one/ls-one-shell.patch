 .Phone {
   position: absolute;
   right: 0;
-  width: 500px;
-  height: 1000px;
+  width: 440px;
+  height: 860px;
   background-size: cover;
 }
 
 .PhoneFrame {
   position: absolute;
   z-index: 999;
-  width: 500px;
-  height: 1000px;
+  width: 440px;
+  height: 860px;
   pointer-events: none;
+  /* LS One: CSS graphite frame replaces the PNG handset image. */
+  background-image: linear-gradient(#D71920, #D71920) !important;
+  background-size: 3px 40px;
+  background-repeat: no-repeat;
+  background-position: calc(100% - 1px) 190px;
+  background-color: transparent;
+  border-radius: 56px;
+  border: 2px solid #282B31;
+  box-shadow:
+    inset 0 0 0 9px #111317,
+    inset 0 0 0 10px #282B31,
+    inset 0 0 0 19px #08090B,
+    0 24px 80px rgba(0, 0, 0, 0.55);
+}
+
+/* LS One punch-hole camera: small, centered, ringed so it reads on dark
+   wallpapers instead of vanishing into them. */
+.PhoneFrame::before {
+  content: '';
+  position: absolute;
+  top: 10px;
+  left: 50%;
+  width: 9px;
+  height: 9px;
+  margin-left: -4.5px;
+  border-radius: 50%;
+  background: radial-gradient(circle at 35% 35%, #23262b 0%, #000000 70%);
+  box-shadow: 0 0 0 1.5px #2a2e35, 0 0 6px rgba(0, 0, 0, 0.8);
+}
+
+/* LS One earpiece slit: subtle, in the top bezel. */
+.PhoneFrame::after {
+  content: '';
+  position: absolute;
+  top: 4px;
+  left: 50%;
+  width: 26px;
+  height: 2px;
+  margin-left: -13px;
+  border-radius: 2px;
+  background: #1e2126;
 }
 
 .PhoneScreen {
   overflow: hidden;
   position: absolute;
   background-color: black;
-  bottom: 100px;
-  left: 50px;
-  right: 50px;
-  top: 100px;
+  bottom: 12px;
+  left: 12px;
+  right: 12px;
+  top: 12px;
   display: flex;
   flex-direction: column;
   background-position: center;
   background-size: cover;
   background-repeat: no-repeat;
-  border-radius: 20px;
+  border-radius: 40px;
 }
 
 .PhoneAppContainer {
-  height: 90%;
+  height: 100%;
   width: 100%;
   display: flex;
   flex-direction: column;
