+/* LS One: the phone behaves like a device, not a webpage - no accidental
+   text highlighting anywhere in the shell or apps. Editable controls opt
+   back into normal text interaction below. */
+.PhoneScreen,
+.PhoneScreen * {
+  user-select: none;
