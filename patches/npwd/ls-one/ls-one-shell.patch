+        mt={7}
+        px={2}
+        sx={{ flex: 1, minHeight: 0, overflowY: 'auto' }}
+      >
+        {apps && <GridMenu xs={3} items={gridApps} />}
+      </Box>
+      <Box display="flex" justifyContent="center" pb="34px" pt={1}>
+        <Box
+          display="flex"
+          alignItems="center"
+          sx={{
+            gap: '20px',
+            padding: '10px 22px',
+            borderRadius: '24px',
+            backgroundColor: 'rgba(20, 23, 29, 0.85)',
+            border: '1px solid #292F3A',
+          }}
+        >
+          {dockApps.map((app) => (
+            <DockApp key={app.id} app={app} />
+          ))}
+        </Box>
       </Box>
-
-      {/*<div className="absolute bottom-5 left-8 right-8">
-        <div className="h-20 w-full rounded-md bg-gray-200/30 backdrop-blur">
-          {apps &&
-            apps.slice(0, 4).map((app) => (
-              <div className="float-left h-full w-1/4" key={app.id}>
-                <div className="flex h-full w-full items-center justify-center">
-                  <div className="flex h-14 w-14 items-center justify-center rounded-md bg-gray-200/50 backdrop-blur">
-                    {app.icon}
-                  </div>
-                </div>
-              </div>
-            ))}
-        </div>
-      </div>*/}
     </AppWrapper>
   );
 };
