+export type CalcKeyTone = 'num' | 'op' | 'eq' | 'clear';
+
+const TONE_SX: Record<CalcKeyTone, { backgroundColor: string; color: string }> = {
+  num: { backgroundColor: '#1E232D', color: '#FFFFFF' },
+  op: { backgroundColor: '#292F3A', color: '#FFFFFF' },
+  eq: { backgroundColor: '#D71920', color: '#FFFFFF' },
+  clear: { backgroundColor: 'transparent', color: '#6F7885' },
+};
+
+export const toneOfLabel = (label: string | number): CalcKeyTone => {
+  if (label === '=') return 'eq';
+  if (label === 'C' || label === 'AC') return 'clear';
+  if (label === '/' || label === '*' || label === '-' || label === '+' || label === '.')
+    return 'op';
+  return 'num';
+};
