new file mode 100644
index 00000000..29c35448
--- /dev/null
+++ b/apps/game/client/cl_environment.ts
@@ -0,0 +1,94 @@
+import { RegisterNuiCB } from './cl_utils';
+
+// Read-only environment bridge for the LS One home-screen widget.
+//
+// Weather comes from the live game state (GetPrevWeatherType). FiveM exposes
+// no temperature native, so the temperature is an ESTIMATE derived from the
+// current weather plus a diurnal curve on the game clock - documented as an
+// approximation, never presented as a sensor reading.
+const WEATHER_BASE_TEMP_C: Record<string, number> = {
+  CLEAR: 28,
+  EXTRASUNNY: 31,
+  NEUTRAL: 27,
+  SMOG: 27,
+  FOGGY: 23,
+  CLOUDS: 26,
+  OVERCAST: 24,
+  RAIN: 22,
+  THUNDER: 21,
+  CLEARING: 25,
+  SNOW: 18,
+  BLIZZARD: 17,
+  SNOWLIGHT: 19,
+  XMAS: 20,
+  HALLOWEEN: 26,
+};
+
+const WEATHER_LABEL: Record<string, string> = {
+  CLEAR: 'Cerah',
+  EXTRASUNNY: 'Sangat Cerah',
+  NEUTRAL: 'Netral',
+  SMOG: 'Berasap',
+  FOGGY: 'Berkabut',
+  CLOUDS: 'Berawan',
+  OVERCAST: 'Mendung',
+  RAIN: 'Hujan',
+  THUNDER: 'Badai Petir',
+  CLEARING: 'Hujan Reda',
+  SNOW: 'Bersalju',
+  BLIZZARD: 'Badai Salju',
+  SNOWLIGHT: 'Salju Ringan',
+  XMAS: 'Natal',
+  HALLOWEEN: 'Berkabut',
+};
+
+function estimateTempC(weather: string, hour: number): number {
+  const base = WEATHER_BASE_TEMP_C[weather] ?? 26;
+  // Warmest ~14:00, coolest ~04:00, +/-3C swing.
+  const swing = -Math.cos(((hour - 4) / 24) * Math.PI * 2) * 3;
+  return Math.round(base + swing);
+}
+
+// Jenkins one-at-a-time hash (what FiveM's joaat() computes). Needed because
+// GetPrevWeatherType() hands back a HASH number, not a name string.
+function joaat(key: string): number {
+  const s = key.toLowerCase();
+  let h = 0;
+  for (let i = 0; i < s.length; i++) {
+    h += s.charCodeAt(i);
+    h += h << 10;
+    h ^= h >>> 6;
+  }
+  h += h << 3;
+  h ^= h >>> 11;
+  h += h << 15;
+  return h >>> 0;
+}
+
+const WEATHER_HASH_TO_NAME: Record<number, string> = {};
+for (const name of Object.keys(WEATHER_BASE_TEMP_C)) {
+  WEATHER_HASH_TO_NAME[joaat(name)] = name;
+}
+for (const name of Object.keys(WEATHER_LABEL)) {
+  if (!WEATHER_HASH_TO_NAME[joaat(name)]) WEATHER_HASH_TO_NAME[joaat(name)] = name;
+}
+
+// Resolve the previous weather type to a name, whether the native handed
+// back a string or a hash number. Never leaks a raw hash to the UI.
+function resolveWeather(raw: unknown): string {
+  if (typeof raw === 'string') return raw;
+  if (typeof raw === 'number') return WEATHER_HASH_TO_NAME[raw >>> 0] ?? 'CLEAR';
+  return 'CLEAR';
+}
+
+RegisterNuiCB('npwd:getEnvironment', (_, cb) => {
+  // Environment only: weather + temperature estimate. The hero clock reads
+  // NPWD's canonical phone-time store in the UI, so this payload carries no
+  // clock fields that could drift against the status bar.
+  const weather = resolveWeather(GetPrevWeatherType());
+  cb({
+    weather,
+    label: WEATHER_LABEL[weather] ?? weather,
+    tempC: estimateTempC(weather, GetClockHours()),
+  });
+});
